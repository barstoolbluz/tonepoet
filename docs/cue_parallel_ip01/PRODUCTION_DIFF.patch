+/// One route decision per *attempt* of a physical decoder group, not proof of
+/// a distinct group. Observer recovery is explicitly marked separately.
+fn cue_ip01_route(
+    req: &PipelineRequest,
+    tracks: &[ScheduledCueStreamTrack],
+    route: &'static str,
+    reason: &'static str,
+) {
+    if !super::baseline::enabled() {
+        return;
