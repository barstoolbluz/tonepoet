+async fn try_encode_cue_s3_pilot(
+    requested: bool,
+    tracks: &[ScheduledCueStreamTrack],
+    source: &PreparedSource,
+    req: &PipelineRequest,
+    convert_root: &Path,
+    limits: Option<&Arc<ToolConcurrencyLimits>>,
+    runner: &dyn ToolRunner,
+    cancel: &CancellationToken,
+) -> Option<ScheduledCueStreamBatch> {
+    if !requested {
+        return None;
+    }
+    let prepared = match cue_s3_pilot_preflight(
+        requested, source, tracks, req, convert_root, limits,
+    ) {
+        Ok(prepared) => prepared,
+        Err(reason) => {
+            // Auditable opt-in rejection, not an attempted/failed conversion.
+            log::info!("CUE S3 pilot not selected for job {}: {reason}", req.job_id);
+            if super::baseline::enabled() {
+                super::baseline::cue_emit(&req.job_id, "s3_pilot_decision", serde_json::json!({
+                    "selected": false, "reason": reason,
+                    "fallback": "existing_s1_or_carrier_route",
+                }));
+            }
+            return None;
+        }
+    };
+    let limits = limits.expect("admitted S3 requires shared tool limits");
+    cue_ip01_route(req, tracks, "s3", "exact_flac_pilot_opt_in");
+    log::info!("CUE S3 pilot admitted for job {} ({} tracks); ReplayGain measured after output",
+        req.job_id, tracks.len());
+    if super::baseline::enabled() {
+        // Retain the same per-album ReplayGain policy event as S1. Selection
+        // is not a claim that tags have already been written or verified.
+        super::baseline::cue_emit(&req.job_id, "replaygain_policy", serde_json::json!({
+            "requested": cue_ip01_rg_policy(req),
+            "source_pass_candidate": false,
+            "source_pass_observed": false,
+            "note": "s3_uses_native_post_output_replaygain",
+        }));
+        super::baseline::cue_emit(&req.job_id, "s3_pilot_decision", serde_json::json!({
+            "selected": true,
+            "track_ordinals": tracks.iter().map(|item| item.track.id.source_ordinal).collect::<Vec<_>>(),
+            "source_pass_replaygain": false,
+            "post_output_replaygain": req.stages.replaygain == StageRequirement::Enabled,
+        }));
+    }
+    let outputs = run_prepared_qualified_flac_ranges(
+        prepared, req, runner, cancel, limits, true,
+    ).await;
+    Some(ScheduledCueStreamBatch {
+        outputs,
+        // The existing album post-processing barrier owns native ReplayGain
+        // for all successfully encoded staged files, including Both/IfMissing.
+        source_replaygain: None,
+    })
+}
