+/// Hidden, process-scoped IP-05 development opt-in. It defaults OFF; only
+/// the exact value `1` selects the pilot, and no request, output directory or
+/// manifest is mutated to persist the gate. Do not promote it in IP-05.
+fn cue_s3_pilot_requested() -> bool {
+    std::env::var("TONEPOET_CUE_S3_PILOT").as_deref() == Ok("1")
+}
+
+/// All eligibility facts must hold for the complete materialized CUE album,
+/// not only the first worker. A rejection leaves the existing S1/source-pass
+/// RG and file-backed fallback paths untouched. Read-only predicates precede
+/// the actual IP-04 typed, source/probe/planner preflight.
+fn cue_s3_pilot_preflight(
+    requested: bool,
+    source: &PreparedSource,
+    tracks: &[ScheduledCueStreamTrack],
+    req: &PipelineRequest,
+    convert_root: &Path,
+    limits: Option<&Arc<ToolConcurrencyLimits>>,
+) -> Result<Vec<CueS3PrivatePrepared>, String> {
+    if !requested {
+        return Err("pilot_disabled".to_string());
+    }
+    if !cfg!(unix) {
+        return Err("two_process_runner_unsupported_on_platform".to_string());
+    }
+    let limits = limits.ok_or("shared_tool_limits_unavailable")?;
+    if source.kind != SourceKind::CueImage
+        || req.merge
+        || source.tracks.len() < 2
+        || source.tracks.len() != tracks.len()
+        // The materializer filters `source.tracks` to the user selection,
+        // but retains the full authored CUE count in album metadata.
+        || source.tracks.len() != source.album_metadata.total_tracks as usize
+    {
+        return Err("not_one_complete_multi_track_cue_album".to_string());
+    }
+    if req.settings.target_format != tonepoet_pipeline::AudioFormat::Flac
+        || req.settings.target_sample_rate != RateTarget::Source
+        || req.settings.target_bit_depth != BitDepthTarget::Source
+        || !req.registered_effects.is_empty()
+        || req.settings.dither_type != tonepoet_pipeline::DitherType::None
+        || req.settings.pcm_true_peak.is_active()
+    {
+        return Err("non_identity_pcm_or_registered_processing".to_string());
+    }
+    // Require the scheduler's exact authored sequence and one physical FILE.
+    // No partial group activation or cross-FILE ReplayGain membership change.
+    if !tracks.iter().enumerate().all(|(index, item)| {
+        item.index == index && item.track.id == source.tracks[index].id
+            && item.track.source_ref == source.tracks[index].source_ref
+    }) || cue_stream_groups(tracks).len() != 1 {
+        return Err("non_contiguous_or_multiple_physical_files".to_string());
+    }
+    let TrackSourceRef::CueStreamSegment { source_image, decode_path, .. } =
+        &tracks[0].track.source_ref else {
+        return Err("non_exact_cue_stream_source".to_string());
+    };
+    if source_image != decode_path {
+        return Err("physical_flac_decode_authority_differs_from_image".to_string());
+    }
+    // This is one all-member preflight, before ANY native child starts. It
+    // independently rechecks FLAC STREAMINFO and the exact sample extents,
+    // planner shape and every distinct staged/work path.
+    let prepared = prepare_qualified_flac_ranges_for_group(tracks, req, convert_root)
+        .map_err(|error| format!("typed_flac_or_planner_preflight_failed: {error}"))?;
+    // Static native capacity, not ephemeral availability; competing albums
+    // await permits only after the entire group has passed this gate.
+    if prepared.iter().any(|member| {
+        member.consumer.binary == ToolBinary::Ffmpeg
+            && limits.ffmpeg_max_concurrent() < 2
+    }) {
+        for member in &prepared {
+            cleanup_cue_stream_direct_track_plan(&member.plan);
+        }
+        return Err("encoder_pair_exceeds_native_child_capacity".to_string());
+    }
+    Ok(prepared)
+}
