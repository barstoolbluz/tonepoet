+struct CueS3SourceMeterPlan {
+    generation: CueS3SourceGeneration,
+    works: Vec<CueS3SourceMeterWork>,
+    manifest: crate::convert::replaygain::ReplayGainManifestBinding,
+    demand: crate::convert::replaygain::MetricDemand,
+    needs_album: bool,
+    active_cap: usize,
+}
