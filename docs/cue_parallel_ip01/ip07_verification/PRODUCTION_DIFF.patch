+async fn run_cue_s3_source_meter_album(
+    plan: CueS3SourceMeterPlan,
+    job_id: &str,
+    runner: &dyn ToolRunner,
+    limits: &Arc<ToolConcurrencyLimits>,
+    cancel: &CancellationToken,
+) -> Result<Vec<crate::convert::replaygain::OwnedTrackObservation>, String> {
+    let mut pending = VecDeque::from(plan.works);
+    let mut done = (0..pending.len()).map(|_| None).collect::<Vec<_>>();
+    let mut first_error = None;
+    let scope = cancel.child_token();
+    let mut first = pending.pop_front().map(|work| Box::pin(
+        run_one_cue_s3_source_meter(work, &plan.generation, job_id, runner, limits, &scope)
+    ));
+    let mut second = if plan.active_cap > 1 {
+        pending.pop_front().map(|work| Box::pin(
+            run_one_cue_s3_source_meter(work, &plan.generation, job_id, runner, limits, &scope)
+        ))
+    } else { None };
+    // Sliding fixed-size window, not one spawn or one memory allotment per
+    // album member. On first fault cancel peers and await their supervisors.
+    while first.is_some() || second.is_some() {
+        let (slot, observation) = match (&mut first, &mut second) {
+            (Some(a), Some(b)) => tokio::select! {
+                result = a => (0, result),
+                result = b => (1, result),
+            },
+            (Some(a), None) => (0, a.await),
+            (None, Some(b)) => (1, b.await),
+            (None, None) => unreachable!("source meter has live task"),
+        };
+        match observation {
+            Ok((index, result)) if index < done.len() && done[index].is_none() => {
+                done[index] = Some(result);
+            }
+            Ok((index, _)) => {
+                first_error.get_or_insert_with(|| format!(
+                    "source meter returned duplicate or foreign member index {index}"
+                ));
+                scope.cancel();
+            }
+            Err(error) => {
+                first_error.get_or_insert(error);
+                scope.cancel();
+            }
+        }
+        let next = if first_error.is_none() {
+            pending.pop_front().map(|work| Box::pin(
+                run_one_cue_s3_source_meter(work, &plan.generation, job_id, runner, limits, &scope)
+            ))
+        } else { None };
+        if slot == 0 { first = next; } else { second = next; }
+    }
+    if cancel.is_cancelled() {
+        return Err("source meter cancelled by conversion owner or user".to_string());
+    }
+    if let Some(error) = first_error { return Err(error); }
+    plan.generation.verify().map_err(|error| error.to_string())?;
+    done.into_iter().enumerate().map(|(index, item)| {
+        item.ok_or_else(|| format!("missing source-range observation at authored index {index}"))
+    }).collect()
+}
