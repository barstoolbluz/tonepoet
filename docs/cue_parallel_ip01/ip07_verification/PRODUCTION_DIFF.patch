+/// Native child is supervised by ToolRunner with one shared FFmpeg permit.
+/// A reader failure never interrupts an otherwise successful S3 conversion;
+/// its returned statistics are discarded for the entire album on failure.
+async fn run_one_cue_s3_source_meter(
+    work: CueS3SourceMeterWork,
+    generation: &CueS3SourceGeneration,
+    job_id: &str,
+    runner: &dyn ToolRunner,
+    limits: &Arc<ToolConcurrencyLimits>,
+    cancel: &CancellationToken,
+) -> Result<(usize, crate::convert::replaygain::OwnedTrackObservation), String> {
+    generation.verify().map_err(|error| error.to_string())?;
+    let started = Instant::now();
+    let decoder_command = work.decoder.command();
+    let decoder_args = decoder_command.sanitized_args();
+    let output = run_cue_source_meter_with_concurrency(
+        decoder_command, work.spec, work.decoder.extent_verifier(),
+        runner, cancel, limits,
+    ).await;
+    let elapsed_ms = started.elapsed().as_secs_f64() * 1000.0;
+    let mut queue_wait_ms = None;
+    let mut active_wall_ms = None;
+    let mut completed_command = None;
+    let result = output.map_err(|error| format!(
+        "source-range FFmpeg/native meter for ordinal {} range [{}, {}): {error}",
+        work.track_id.source_ordinal, work.range.0, work.range.1,
+    )).and_then(|output| {
+        queue_wait_ms = Some(output.queue_wait.as_secs_f64() * 1000.0);
+        active_wall_ms = Some(output.active_wall.as_secs_f64() * 1000.0);
+        completed_command = Some(output.decoder.command.clone());
+        generation.verify().map_err(|error| error.to_string())?;
+        if output.decoder.command.exit.is_none() {
+            return Err("source-range tool supervisor did not retain a completed command".to_string());
+        }
+        Ok((work.index, output.observation))
+    });
+    if result.is_ok() {
+        log::info!("CUE S3 source-range native meter completed for job {job_id}, source ordinal {}, range [{}, {})", work.track_id.source_ordinal, work.range.0, work.range.1);
+    } else {
+        log::warn!("CUE S3 source-range native meter failed for job {job_id}, source ordinal {}, range [{}, {}): {}; discarding album source scan", work.track_id.source_ordinal, work.range.0, work.range.1, result.as_ref().unwrap_err());
+    }
+    if super::baseline::enabled() {
+        super::baseline::cue_emit(job_id, "s3_source_meter_track_settled", serde_json::json!({
+            "track_ordinal": work.track_id.source_ordinal,
+            "replaygain_member_id": work.member_id,
+            "start_sample": work.range.0,
+            "end_sample": work.range.1,
+            "elapsed_inclusive_queue_and_native_ms": elapsed_ms,
+            "ffmpeg_permit_wait_ms": queue_wait_ms,
+            "native_meter_active_wall_ms": active_wall_ms,
+            "decoder_sanitized_args": decoder_args,
+            "decoder_completed_command": completed_command,
+            "ok": result.is_ok(),
+            "failure": result.as_ref().err(),
+        }));
+    }
+    result
+}
