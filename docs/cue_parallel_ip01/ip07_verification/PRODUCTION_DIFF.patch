+struct CueS3SourceMeterWork {
+    index: usize,
+    track_id: TrackId,
+    member_id: String,
+    range: (u64, u64),
+    decoder: CueFlacRangeDecoder,
+    spec: crate::convert::replaygain::CueSourceRangeObservationSpec,
+}
