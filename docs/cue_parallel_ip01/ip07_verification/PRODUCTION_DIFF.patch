+/// A retained original-album source scan may never tag an arbitrary partial
+/// cohort, a realized fallback output, or an artifact whose authored identity
+/// has drifted since the S3 admission boundary.
+fn cue_s3_source_meter_outputs_match(
+    outputs: &[ScheduledTrackOutput],
+    prepared: &[ScheduledCueStreamTrack],
+    staged_paths: &[PathBuf],
+) -> bool {
+    outputs.len() == prepared.len() && staged_paths.len() == prepared.len()
+        && outputs.iter().zip(prepared).zip(staged_paths).all(|((out, expected), staged)| {
+        out.ok && out.index == expected.index
+            && out.record.track_id == expected.track.id
+            && out.record.source_ref == expected.track.source_ref
+            && out.record.realized_input.is_none()
+            && out.artifact.as_ref().is_some_and(|artifact| {
+                artifact.track_id == expected.track.id
+                    && artifact.final_path == expected.final_path
+                    && &artifact.staged_path == staged
+                    && artifact.staged_path.is_file()
+            })
+    })
+}
