+/// This additional optimization must not broaden IP-05 admission or alter
+/// S1 source-pass eligibility. Missing headroom uses S3's old output pass
+/// rather than burning a native child permit on a non-overlapping reader.
+fn cue_s3_source_meter_plan(
+    prepared: &[CueS3PrivatePrepared],
+    source: &PreparedSource,
+    req: &PipelineRequest,
+    limits: &Arc<ToolConcurrencyLimits>,
+    runner: &dyn ToolRunner,
+) -> Result<CueS3SourceMeterPlan, String> {
+    if !cue_source_replaygain_eligible(source, req) {
+        return Err("source_pass_policy_ineligible".to_string());
+    }
+    if !runner.supports_cue_source_range_observation() {
+        return Err("tool_runner_has_no_supervised_native_stream_handoff".to_string());
+    }
+    let available = limits.ffmpeg_max_concurrent().saturating_sub(2);
+    if available == 0 {
+        return Err("no_ffmpeg_meter_headroom_beyond_one_s3_worker".to_string());
+    }
+    let storage_limit = crate::convert::replaygain::cue_observer_storage_limit(prepared.len())
+        .map_err(|error| format!("native_meter_storage: {error}"))?;
+    let demand = crate::convert::replaygain::MetricDemand::IntegratedOnly;
+    let mode = req.settings.replay_gain.mode.unwrap_or(tonepoet_pipeline::ReplayGainMode::Both);
+    let needs_album = matches!(mode,
+        tonepoet_pipeline::ReplayGainMode::Both | tonepoet_pipeline::ReplayGainMode::Album);
+    let mut works = Vec::with_capacity(prepared.len());
+    let mut members = Vec::with_capacity(prepared.len());
+    let mut last_end = None;
+    let mut physical = None;
+    for member in prepared {
+        let TrackSourceRef::CueStreamSegment {
+            source_image, decode_path, channels, carrier, image_samples,
+            start_sample, samples, ..
+        } = &member.input.track.source_ref else {
+            return Err("non_exact_source_segment".to_string());
+        };
+        if *carrier != CueSegmentCarrier::PcmS32LeWav || source_image != decode_path {
+            return Err("source_and_meter_pcm_carrier_differ".to_string());
+        }
+        let range = member.decoder.sample_bounds();
+        if range.0 != *start_sample
+            || range.1 != start_sample.checked_add(*samples).unwrap_or(0)
+            || last_end.is_some_and(|end| end != range.0)
+            || range.0 >= range.1 || range.1 > *image_samples
+        {
+            return Err("cue_authored_range_gap_overlap_or_mismatch".to_string());
+        }
+        last_end = Some(range.1);
+        if let Some((path, image_size)) = &physical {
+            if path.as_path() != member.decoder.source_path() || image_size != image_samples {
+                return Err("source_meter_physical_file_or_size_drift".to_string());
+            }
+        } else {
+            physical = Some((member.decoder.source_path().to_path_buf(), *image_samples));
+        }
+        if member.input.track.expected_samples != Some(*samples)
+            || member.input.track.source_audio.coding != Some(SourceAudioCoding::Pcm)
+            || member.input.track.source_audio.bit_depth != member.input.track.bit_depth
+        {
+            return Err("source_meter_typed_pcm_facts_mismatch".to_string());
+        }
+        let sample_rate = member.input.track.scalar_sample_rate()
+            .ok_or("source_meter_missing_typed_rate")?;
+        crate::convert::replaygain::preflight_cue_observer(
+            sample_rate, *channels, demand, storage_limit,
+        ).map_err(|error| format!("native_meter_preflight: {error}"))?;
+        let member_id = replaygain_member_id(&member.input.track.id);
+        members.push(member_id.clone());
+        works.push(CueS3SourceMeterWork {
+            index: member.input.index,
+            track_id: member.input.track.id.clone(),
+            member_id: member_id.clone(),
+            range,
+            decoder: member.decoder.clone(),
+            spec: crate::convert::replaygain::CueSourceRangeObservationSpec {
+                member_id, sample_rate_hz: sample_rate, channels: *channels,
+                frames: *samples, demand, storage_limit_bytes: storage_limit,
+            },
+        });
+    }
+    let (path, _) = physical.ok_or("source_meter_empty_album")?;
+    let generation = CueS3SourceGeneration::capture(&path)
+        .map_err(|error| format!("source_generation_admission: {error}"))?;
+    let manifest = crate::convert::replaygain::ReplayGainManifestBinding::new(members)
+        .map_err(|error| format!("source_meter_manifest: {error}"))?;
+    Ok(CueS3SourceMeterPlan {
+        generation, works, manifest, demand, needs_album,
+        active_cap: available.min(2),
+    })
+}
